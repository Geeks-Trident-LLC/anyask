include LICENSE
include README.md

# Include YAML files inside the package
recursive-include llmbridge *.yaml

# Include any JSON files (if you add them later)
recursive-include llmbridge *.json

# Include any template files (future-proof)
recursive-include llmbridge *.txt

# Exclude tests, docs, examples from source distribution
prune tests
prune docs
prune examples
prune scripts

# Re-include markdown docs under tests/ (e.g. tests/integration/README.md)
recursive-include tests *.md
